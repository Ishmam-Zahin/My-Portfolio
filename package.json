{
  "name": "portfolio-website",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "watch": "sass sass/main.scss css/style-uncompressed.css -w",
    "devserver": "live-server --port=5500",
    "start": "npm-run-all -p watch devserver",

    "compile:sass": "sass sass/main.scss css/style-uncompressed.css",
    "compress:css": "sass css/style-uncompressed.css css/style.css --output-style compressed",
    "build": "npm-run-all compile:sass compress:css"
  },
  "author": "zahin",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.86.0"
  }
}
